        "de": "Der Schlüssel eines Geräts läuft innerhalb der eingestellten Warnfrist ab.",
        "es": "La clave de una máquina caduca dentro del plazo de aviso configurado."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Machine",
            "fr": "Machine",
            "de": "Gerät",
            "es": "Máquina"
