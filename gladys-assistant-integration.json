          "label": {
            "en": "Last seen",
            "fr": "Vue pour la dernière fois",
            "de": "Zuletzt gesehen",
            "es": "Vista por última vez"
          }
        }
      ]
    },
    {
      "key": "machine_added",
      "label": {
        "en": "New machine in the tailnet",
        "fr": "Nouvelle machine dans le tailnet",
        "de": "Neues Gerät im Tailnet",
        "es": "Nueva máquina en la tailnet"
      },
      "description": {
        "en": "A machine joined the tailnet, approved or waiting for approval.",
        "fr": "Une machine a rejoint le tailnet, approuvée ou en attente d'approbation.",
        "de": "Ein Gerät ist dem Tailnet beigetreten, freigegeben oder wartend.",
        "es": "Una máquina se unió a la tailnet, aprobada o pendiente de aprobación."
      },
      "fields": [
