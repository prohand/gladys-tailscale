  "scene_actions": [
    {
      "key": "refresh_tailnet",
      "label": {
        "en": "Refresh the tailnet",
        "fr": "Actualiser le tailnet",
        "de": "Tailnet aktualisieren",
        "es": "Actualizar la tailnet"
      },
      "description": {
        "en": "Reads every machine now and returns the counts.",
        "fr": "Lit toutes les machines maintenant et renvoie les totaux.",
        "de": "Liest jetzt alle Geräte und gibt die Anzahlen zurück.",
        "es": "Lee todas las máquinas ahora y devuelve los totales."
      },
      "timeout_seconds": 30,
      "outputs": [
        {
          "key": "machine_count",
          "type": "number",
          "label": {
            "en": "Machines",
            "fr": "Machines",
            "de": "Geräte",
            "es": "Máquinas"
          }
        },
        {
          "key": "online_count",
          "type": "number",
          "label": {
            "en": "Machines online",
            "fr": "Machines en ligne",
            "de": "Geräte online",
            "es": "Máquinas en línea"
          }
        },
        {
          "key": "offline_count",
          "type": "number",
          "label": {
            "en": "Machines offline",
            "fr": "Machines hors ligne",
            "de": "Geräte offline",
            "es": "Máquinas sin conexión"
          }
        }
      ]
    },
    {
      "key": "get_machine_status",
      "label": {
        "en": "Read a machine's status",
        "fr": "Lire l'état d'une machine",
        "de": "Gerätestatus lesen",
        "es": "Leer el estado de una máquina"
      },
      "description": {
        "en": "Returns the state of a machine for the next actions of the scene.",
        "fr": "Renvoie l'état d'une machine pour les actions suivantes de la scène.",
        "de": "Gibt den Zustand eines Geräts für die nächsten Aktionen der Szene zurück.",
        "es": "Devuelve el estado de una máquina para las siguientes acciones de la escena."
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Machine",
            "fr": "Machine",
            "de": "Gerät",
            "es": "Máquina"
          },
          "required": true
        }
      ],
      "outputs": [
        {
