          "label": {
            "en": "Online",
            "fr": "En ligne",
            "de": "Online",
            "es": "En línea"
          }
        },
        {
          "key": "ip",
          "type": "string",
          "label": {
            "en": "Tailscale IP",
            "fr": "IP Tailscale",
            "de": "Tailscale-IP",
            "es": "IP de Tailscale"
          }
        },
        {
          "key": "last_seen",
          "type": "string",
          "label": {
            "en": "Last seen",
            "fr": "Vue pour la dernière fois",
            "de": "Zuletzt gesehen",
            "es": "Vista por última vez"
          }
        },
        {
          "key": "os",
