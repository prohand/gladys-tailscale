          "type": "string",
          "label": {
            "en": "Tailscale IP",
            "fr": "IP Tailscale",
            "de": "Tailscale-IP",
            "es": "IP de Tailscale"
          }
        }
      ]
    },
    {
      "key": "update_available",
      "label": {
